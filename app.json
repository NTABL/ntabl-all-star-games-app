{
  "expo": {
    "name": "NTABL",
    "slug": "ntabl-all-star-games-app",
    "scheme": "ntablallstargames",
    "version": "2.0.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
 "plugins": [
   "expo-router",
   "expo-video",
   "expo-secure-store",
   "expo-font",
   "expo-notifications"
 ],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b1f3a"
    },
"android": {
  "package": "com.ntabl.allstargames",
  "versionCode": 10,
  "googleServicesFile": "./google-services.json",
  "adaptiveIcon": {
    "foregroundImage": "./assets/adaptive-icon.png",
    "backgroundColor": "#0b1f3a"
  }
},
"ios": {
  "bundleIdentifier": "com.ntabl.allstargames",
  "buildNumber": "10",
  "supportsTablet": true,
  "infoPlist": {
    "ITSAppUsesNonExemptEncryption": false
  }
},
    "web": {
      "bundler": "metro",
      "name": "NTABL All-Star Games",
      "shortName": "NTABL",
      "themeColor": "#0b1f3a",
      "backgroundColor": "#0b1f3a",
      "display": "standalone",
      "orientation": "portrait"
    },
    "extra": {
      "apiBase": "https://ntabl-backend.onrender.com",
      "router": {},
      "eas": {
        "projectId": "e6454d9d-b07f-4578-b459-5a86df57c063"
      }
    }
  }
}